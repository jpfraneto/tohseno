{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/schemas/app-manifest-v1.json",
  "title": "TOHSENO app manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "application",
    "platform",
    "composition",
    "data",
    "storage",
    "network",
    "identity",
    "entitlements",
    "integrations",
    "operations",
    "privacy",
    "production",
    "irreversibleOperations"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": { "const": "app" },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]+(?:\\.[A-Za-z0-9-]+)+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 }
      }
    },
    "platform": { "const": "ios" },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "template", "skills"],
      "properties": {
        "kernel": { "$ref": "#/$defs/id" },
        "template": { "$ref": "#/$defs/id" },
        "skills": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "remote"],
      "properties": {
        "local": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "remote": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
      }
    },
    "storage": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "location", "content"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "location": { "type": "string", "minLength": 1 },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "network": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "data"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "purpose": { "type": "string", "minLength": 1 },
          "data": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "enum": ["none", "local-device", "wallet", "account"]
        },
        "details": { "type": "string", "minLength": 1 }
      }
    },
    "entitlements": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "integrations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "scheme", "product"],
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+\\.xcodeproj$"
        },
        "scheme": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "product": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawIntentionTracked", "appContentLeavesDevice"],
      "properties": {
        "rawIntentionTracked": { "const": false },
        "appContentLeavesDevice": { "type": "boolean" },
        "declarations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready", "declarations"],
      "properties": {
        "ready": { "type": "boolean" },
        "declarations": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    },
    "irreversibleOperations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "approval"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "approval": { "const": "explicit-owner" }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
