{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tohseno:schema:identity-reference:v1",
  "title": "TOHSENO identity reference",
  "type": "object",
  "additionalProperties": false,
  "required": ["role", "method", "id"],
  "properties": {
    "role": { "enum": ["BUILDER", "CONTINUITY"] },
    "method": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:~-]{1,200}$"
    }
  }
}
