{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/schemas/app-template-v1.json",
  "title": "TOHSENO bundled app template",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "platforms",
    "kernel",
    "skills",
    "agentInstructions",
    "definitionOfDone"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "platforms": {
      "type": "array",
      "const": ["ios"],
      "uniqueItems": true
    },
    "kernel": { "$ref": "#/$defs/id" },
    "skills": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "overlay": { "$ref": "#/$defs/path" },
    "replaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "agentInstructions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    },
    "definitionOfDone": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "\\S" },
        { "pattern": "^(?![\\\\/])" },
        { "not": { "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)" } },
        { "not": { "pattern": "[\\\\/]{2}" } },
        { "not": { "pattern": "[\\\\/]$" } }
      ]
    }
  }
}
