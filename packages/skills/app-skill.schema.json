{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/schemas/app-skill-v1.json",
  "title": "TOHSENO bundled app skill",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "summary",
    "category",
    "maturity",
    "platforms",
    "requires",
    "conflicts",
    "contributions",
    "acceptanceChecks",
    "agentInstructions"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "category": {
      "enum": ["experience", "data", "progression", "sharing"]
    },
    "maturity": { "enum": ["experimental", "stable"] },
    "platforms": {
      "type": "array",
      "const": ["ios"],
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "contributions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overlay",
        "manifestFragments",
        "entitlements",
        "privacy",
        "xcodeSourcePaths"
      ],
      "properties": {
        "overlay": { "$ref": "#/$defs/path" },
        "manifestFragments": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "entitlements": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "privacy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "xcodeSourcePaths": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        },
        "replaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/path" }
        }
      }
    },
    "acceptanceChecks": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "path"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "const": "file" },
          "path": { "$ref": "#/$defs/path" }
        }
      }
    },
    "agentInstructions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "allOf": [
        { "pattern": "\\S" },
        { "pattern": "^(?![\\\\/])" },
        { "not": { "pattern": "(?:^|[\\\\/])\\.{1,2}(?:[\\\\/]|$)" } },
        { "not": { "pattern": "[\\\\/]{2}" } },
        { "not": { "pattern": "[\\\\/]$" } }
      ]
    }
  }
}
