{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tohseno:schema:signed-public-shot-record:v1",
  "title": "TOHSENO signed public Shot record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "kind",
    "shotId",
    "sequence",
    "previousRecordHash",
    "recordedAt",
    "authority",
    "body",
    "signature"
  ],
  "properties": {
    "protocolVersion": { "const": 1 },
    "kind": {
      "enum": [
        "SHOT_CREATED",
        "EVOLUTION_RECORDED",
        "LIFECYCLE_TRANSITIONED",
        "APPCOIN_LINKED"
      ]
    },
    "shotId": {
      "type": "string",
      "pattern": "^shot_[A-Za-z0-9_-]{32}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "previousRecordHash": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/sha256" }
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
    },
    "authority": {
      "allOf": [
        { "$ref": "urn:tohseno:schema:verification-method:v1" },
        {
          "properties": {
            "identity": {
              "properties": {
                "role": { "const": "BUILDER" }
              }
            }
          }
        }
      ]
    },
    "body": { "type": "object" },
    "signature": {
      "allOf": [
        { "$ref": "urn:tohseno:schema:signature-envelope:v1" },
        {
          "properties": {
            "identity": {
              "properties": {
                "role": { "const": "BUILDER" }
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "SHOT_CREATED" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "sequence": { "const": 0 },
          "previousRecordHash": { "type": "null" },
          "body": { "$ref": "#/$defs/shotCreated" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "EVOLUTION_RECORDED" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "body": { "$ref": "#/$defs/evolutionRecorded" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "LIFECYCLE_TRANSITIONED" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "body": { "$ref": "#/$defs/lifecycleTransitioned" }
        }
      }
    },
    {
      "if": {
        "properties": { "kind": { "const": "APPCOIN_LINKED" } },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "body": { "$ref": "#/$defs/appcoinLinked" }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "publicString": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)",
          "maxLength": 2048
        },
        "revision": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 200 }
          ]
        }
      }
    },
    "download": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "artifactDigest", "manifestDigest"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)",
          "maxLength": 2048
        },
        "artifactDigest": { "$ref": "#/$defs/sha256" },
        "manifestDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "download"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "download": { "$ref": "#/$defs/download" }
      }
    },
    "appStore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["listingId", "listingUrl"],
      "properties": {
        "listingId": {
          "type": "string",
          "pattern": "^\\d{5,20}$"
        },
        "listingUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://apps\\.apple\\.com/",
          "maxLength": 2048
        }
      }
    },
    "externalIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "id"],
      "properties": {
        "namespace": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 100 }
          ]
        },
        "id": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 300 }
          ]
        }
      }
    },
    "evidenceIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "id"],
      "properties": {
        "namespace": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 100 }
          ]
        },
        "id": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 300 }
          ]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://(?![^/?#]*@)",
          "maxLength": 2048
        }
      }
    },
    "shotCreated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "summary",
        "platform",
        "builder",
        "lifecycle",
        "evolution"
      ],
      "properties": {
        "name": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 120 }
          ]
        },
        "summary": { "$ref": "#/$defs/publicString" },
        "platform": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,31}$"
        },
        "builder": {
          "allOf": [
            { "$ref": "urn:tohseno:schema:identity-reference:v1" },
            {
              "properties": {
                "role": { "const": "BUILDER" }
              }
            }
          ]
        },
        "continuity": {
          "allOf": [
            { "$ref": "urn:tohseno:schema:identity-reference:v1" },
            {
              "properties": {
                "role": { "const": "CONTINUITY" }
              }
            }
          ]
        },
        "lifecycle": { "const": "EVOLVING" },
        "evolution": { "const": 0 }
      }
    },
    "evolutionRecorded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evolution", "title", "summary"],
      "properties": {
        "evolution": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "allOf": [
            { "$ref": "#/$defs/publicString" },
            { "maxLength": 160 }
          ]
        },
        "summary": { "$ref": "#/$defs/publicString" }
      }
    },
    "lifecycleTransitioned": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "evidence"],
          "properties": {
            "from": { "const": "EVOLVING" },
            "to": { "const": "PUBLISHED" },
            "evidence": { "$ref": "#/$defs/publication" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to", "evidence"],
          "properties": {
            "from": { "const": "PUBLISHED" },
            "to": { "const": "APP_STORE" },
            "evidence": { "$ref": "#/$defs/appStore" }
          }
        }
      ]
    },
    "appcoinLinked": {
      "type": "object",
      "additionalProperties": false,
      "required": ["link"],
      "properties": {
        "link": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deployment", "network", "asset", "evidence"],
          "properties": {
            "deployment": { "$ref": "#/$defs/externalIdentifier" },
            "network": { "$ref": "#/$defs/externalIdentifier" },
            "asset": { "$ref": "#/$defs/externalIdentifier" },
            "evidence": { "$ref": "#/$defs/evidenceIdentifier" }
          }
        }
      }
    }
  }
}
