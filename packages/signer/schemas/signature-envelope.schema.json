{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tohseno:schema:signature-envelope:v1",
  "title": "TOHSENO signature envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "identity",
    "suite",
    "keyId",
    "publicKey",
    "encoding",
    "value"
  ],
  "properties": {
    "identity": {
      "$ref": "urn:tohseno:schema:identity-reference:v1"
    },
    "suite": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{0,63}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:~-]{1,200}$"
    },
    "publicKey": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
    },
    "encoding": { "const": "base64url" },
    "value": {
      "type": "string",
      "minLength": 2,
      "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
    }
  }
}
