{
  "openapi": "3.1.0",
  "info": {
    "title": "TOHSENO optional reference node",
    "version": "0.5.0",
    "description": "A replaceable, non-authoritative index for exact signed public Shot records and deterministic public projections."
  },
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The process and SQLite adapter are ready.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "openApi",
        "responses": {
          "200": {
            "description": "This OpenAPI document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/v1/records": {
      "post": {
        "operationId": "submitRecord",
        "description": "Verify and append one exact signed public Shot record. Exact duplicates are idempotent.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignedPublicShotRecord"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The exact record already existed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeSubmissionPayload"
                }
              }
            }
          },
          "201": {
            "description": "The verified record was appended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeSubmissionPayload"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidRecord"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "413": {
            "$ref": "#/components/responses/TooLarge"
          },
          "415": {
            "$ref": "#/components/responses/UnsupportedMediaType"
          },
          "507": {
            "$ref": "#/components/responses/CapacityExceeded"
          }
        }
      }
    },
    "/v1/shots/{shotId}": {
      "get": {
        "operationId": "getProjection",
        "description": "Return the exact deterministic public Shot projection.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ShotId"
          }
        ],
        "responses": {
          "200": {
            "description": "The public Shot projection.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicShotProjection"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/v1/shots/{shotId}/records": {
      "get": {
        "operationId": "getRecords",
        "description": "Export one exact signed record chain in sequence order.",
        "parameters": [
          {
            "$ref": "#/components/parameters/ShotId"
          }
        ],
        "responses": {
          "200": {
            "description": "The accepted signed public records.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeRecordsPayload"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ShotId": {
        "name": "shotId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "pattern": "^shot_[A-Za-z0-9_-]{32}$"
        }
      }
    },
    "schemas": {
      "IdentityReference": {
        "title": "TOHSENO identity reference",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "method",
          "id"
        ],
        "properties": {
          "role": {
            "enum": [
              "BUILDER",
              "CONTINUITY"
            ]
          },
          "method": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:~-]{1,200}$"
          }
        }
      },
      "VerificationMethod": {
        "title": "TOHSENO verification method",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "suite",
          "keyId",
          "publicKey"
        ],
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/IdentityReference"
          },
          "suite": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:~-]{1,200}$"
          },
          "publicKey": {
            "type": "string",
            "minLength": 2,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          }
        }
      },
      "SignatureEnvelope": {
        "title": "TOHSENO signature envelope",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "suite",
          "keyId",
          "publicKey",
          "encoding",
          "value"
        ],
        "properties": {
          "identity": {
            "$ref": "#/components/schemas/IdentityReference"
          },
          "suite": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,63}$"
          },
          "keyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:~-]{1,200}$"
          },
          "publicKey": {
            "type": "string",
            "minLength": 2,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          },
          "encoding": {
            "const": "base64url"
          },
          "value": {
            "type": "string",
            "minLength": 2,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          }
        }
      },
      "SignedPublicShotRecord": {
        "title": "TOHSENO signed public Shot record v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "kind",
          "shotId",
          "sequence",
          "previousRecordHash",
          "recordedAt",
          "authority",
          "body",
          "signature"
        ],
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "kind": {
            "enum": [
              "SHOT_CREATED",
              "EVOLUTION_RECORDED",
              "LIFECYCLE_TRANSITIONED",
              "APPCOIN_LINKED"
            ]
          },
          "shotId": {
            "type": "string",
            "pattern": "^shot_[A-Za-z0-9_-]{32}$"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "previousRecordHash": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/sha256"
              }
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
          },
          "authority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VerificationMethod"
              },
              {
                "properties": {
                  "identity": {
                    "properties": {
                      "role": {
                        "const": "BUILDER"
                      }
                    }
                  }
                }
              }
            ]
          },
          "body": {
            "type": "object"
          },
          "signature": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SignatureEnvelope"
              },
              {
                "properties": {
                  "identity": {
                    "properties": {
                      "role": {
                        "const": "BUILDER"
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "SHOT_CREATED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "sequence": {
                  "const": 0
                },
                "previousRecordHash": {
                  "type": "null"
                },
                "body": {
                  "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/shotCreated"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "EVOLUTION_RECORDED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "body": {
                  "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/evolutionRecorded"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "LIFECYCLE_TRANSITIONED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "body": {
                  "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/lifecycleTransitioned"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "APPCOIN_LINKED"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "properties": {
                "body": {
                  "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/appcoinLinked"
                }
              }
            }
          }
        ],
        "$defs": {
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "publicString": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "revision"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?![^/?#]*@)",
                "maxLength": 2048
              },
              "revision": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 200
                  }
                ]
              }
            }
          },
          "download": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "artifactDigest",
              "manifestDigest"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?![^/?#]*@)",
                "maxLength": 2048
              },
              "artifactDigest": {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/sha256"
              },
              "manifestDigest": {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/sha256"
              }
            }
          },
          "publication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "download"
            ],
            "properties": {
              "source": {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/source"
              },
              "download": {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/download"
              }
            }
          },
          "appStore": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "listingId",
              "listingUrl"
            ],
            "properties": {
              "listingId": {
                "type": "string",
                "pattern": "^\\d{5,20}$"
              },
              "listingUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://apps\\.apple\\.com/",
                "maxLength": 2048
              }
            }
          },
          "externalIdentifier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 100
                  }
                ]
              },
              "id": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 300
                  }
                ]
              }
            }
          },
          "evidenceIdentifier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 100
                  }
                ]
              },
              "id": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 300
                  }
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?![^/?#]*@)",
                "maxLength": 2048
              }
            }
          },
          "shotCreated": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "summary",
              "platform",
              "builder",
              "lifecycle",
              "evolution"
            ],
            "properties": {
              "name": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 120
                  }
                ]
              },
              "summary": {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
              },
              "platform": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,31}$"
              },
              "builder": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/IdentityReference"
                  },
                  {
                    "properties": {
                      "role": {
                        "const": "BUILDER"
                      }
                    }
                  }
                ]
              },
              "continuity": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/IdentityReference"
                  },
                  {
                    "properties": {
                      "role": {
                        "const": "CONTINUITY"
                      }
                    }
                  }
                ]
              },
              "lifecycle": {
                "const": "EVOLVING"
              },
              "evolution": {
                "const": 0
              }
            }
          },
          "evolutionRecorded": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evolution",
              "title",
              "summary"
            ],
            "properties": {
              "evolution": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "title": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
                  },
                  {
                    "maxLength": 160
                  }
                ]
              },
              "summary": {
                "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publicString"
              }
            }
          },
          "lifecycleTransitioned": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "evidence"
                ],
                "properties": {
                  "from": {
                    "const": "EVOLVING"
                  },
                  "to": {
                    "const": "PUBLISHED"
                  },
                  "evidence": {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/publication"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from",
                  "to",
                  "evidence"
                ],
                "properties": {
                  "from": {
                    "const": "PUBLISHED"
                  },
                  "to": {
                    "const": "APP_STORE"
                  },
                  "evidence": {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/appStore"
                  }
                }
              }
            ]
          },
          "appcoinLinked": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link"
            ],
            "properties": {
              "link": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "deployment",
                  "network",
                  "asset",
                  "evidence"
                ],
                "properties": {
                  "deployment": {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/externalIdentifier"
                  },
                  "network": {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/externalIdentifier"
                  },
                  "asset": {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/externalIdentifier"
                  },
                  "evidence": {
                    "$ref": "#/components/schemas/SignedPublicShotRecord/$defs/evidenceIdentifier"
                  }
                }
              }
            }
          }
        }
      },
      "PublicShotProjection": {
        "title": "TOHSENO public Shot projection v1",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "shotId",
          "name",
          "summary",
          "platform",
          "builder",
          "authority",
          "lifecycle",
          "evolution",
          "createdAt",
          "updatedAt",
          "latestRecordHash",
          "recordCount",
          "evolutions",
          "appcoins"
        ],
        "properties": {
          "protocolVersion": {
            "const": 1
          },
          "shotId": {
            "type": "string",
            "pattern": "^shot_[A-Za-z0-9_-]{32}$"
          },
          "name": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
              },
              {
                "maxLength": 120
              }
            ]
          },
          "summary": {
            "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
          },
          "platform": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,31}$"
          },
          "builder": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdentityReference"
              },
              {
                "properties": {
                  "role": {
                    "const": "BUILDER"
                  }
                }
              }
            ]
          },
          "continuity": {
            "allOf": [
              {
                "$ref": "#/components/schemas/IdentityReference"
              },
              {
                "properties": {
                  "role": {
                    "const": "CONTINUITY"
                  }
                }
              }
            ]
          },
          "authority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/VerificationMethod"
              },
              {
                "properties": {
                  "identity": {
                    "properties": {
                      "role": {
                        "const": "BUILDER"
                      }
                    }
                  }
                }
              }
            ]
          },
          "lifecycle": {
            "enum": [
              "EVOLVING",
              "PUBLISHED",
              "APP_STORE"
            ]
          },
          "evolution": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "createdAt": {
            "$ref": "#/components/schemas/PublicShotProjection/$defs/timestamp"
          },
          "updatedAt": {
            "$ref": "#/components/schemas/PublicShotProjection/$defs/timestamp"
          },
          "latestRecordHash": {
            "$ref": "#/components/schemas/PublicShotProjection/$defs/sha256"
          },
          "recordCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "evolutions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicShotProjection/$defs/evolution"
            }
          },
          "publication": {
            "$ref": "#/components/schemas/PublicShotProjection/$defs/publication"
          },
          "appStore": {
            "$ref": "#/components/schemas/PublicShotProjection/$defs/appStore"
          },
          "appcoins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublicShotProjection/$defs/appcoin"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "EVOLVING"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "publication"
                    ]
                  },
                  {
                    "required": [
                      "appStore"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "PUBLISHED"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "required": [
                "publication"
              ],
              "not": {
                "required": [
                  "appStore"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "lifecycle": {
                  "const": "APP_STORE"
                }
              },
              "required": [
                "lifecycle"
              ]
            },
            "then": {
              "required": [
                "publication",
                "appStore"
              ]
            }
          }
        ],
        "$defs": {
          "publicString": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001F\\u007F]+$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}Z$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "revision"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?![^/?#]*@)",
                "maxLength": 2048
              },
              "revision": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
                  },
                  {
                    "maxLength": 200
                  }
                ]
              }
            }
          },
          "download": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "artifactDigest",
              "manifestDigest"
            ],
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?![^/?#]*@)",
                "maxLength": 2048
              },
              "artifactDigest": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/sha256"
              },
              "manifestDigest": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/sha256"
              }
            }
          },
          "publication": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "download"
            ],
            "properties": {
              "source": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/source"
              },
              "download": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/download"
              }
            }
          },
          "appStore": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "listingId",
              "listingUrl"
            ],
            "properties": {
              "listingId": {
                "type": "string",
                "pattern": "^\\d{5,20}$"
              },
              "listingUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://apps\\.apple\\.com/",
                "maxLength": 2048
              }
            }
          },
          "evolution": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "evolution",
              "title",
              "summary",
              "recordedAt",
              "recordHash"
            ],
            "properties": {
              "evolution": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "title": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
                  },
                  {
                    "maxLength": 160
                  }
                ]
              },
              "summary": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
              },
              "recordedAt": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/timestamp"
              },
              "recordHash": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/sha256"
              }
            }
          },
          "identifier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
                  },
                  {
                    "maxLength": 100
                  }
                ]
              },
              "id": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
                  },
                  {
                    "maxLength": 300
                  }
                ]
              }
            }
          },
          "evidenceIdentifier": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "id"
            ],
            "properties": {
              "namespace": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
                  },
                  {
                    "maxLength": 100
                  }
                ]
              },
              "id": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/PublicShotProjection/$defs/publicString"
                  },
                  {
                    "maxLength": 300
                  }
                ]
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://(?![^/?#]*@)",
                "maxLength": 2048
              }
            }
          },
          "link": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "deployment",
              "network",
              "asset",
              "evidence"
            ],
            "properties": {
              "deployment": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/identifier"
              },
              "network": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/identifier"
              },
              "asset": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/identifier"
              },
              "evidence": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/evidenceIdentifier"
              }
            }
          },
          "appcoin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "link",
              "recordedAt",
              "recordHash"
            ],
            "properties": {
              "link": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/link"
              },
              "recordedAt": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/timestamp"
              },
              "recordHash": {
                "$ref": "#/components/schemas/PublicShotProjection/$defs/sha256"
              }
            }
          }
        }
      },
      "NodeSubmissionPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "status",
          "recordHash",
          "projection"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "status": {
            "enum": [
              "appended",
              "existing"
            ]
          },
          "recordHash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "projection": {
            "$ref": "#/components/schemas/PublicShotProjection"
          }
        }
      },
      "NodeRecordsPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schemaVersion",
          "records"
        ],
        "properties": {
          "schemaVersion": {
            "const": 1
          },
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/components/schemas/SignedPublicShotRecord"
            }
          }
        }
      },
      "NodeErrorPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          }
        }
      },
      "Health": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "service",
          "databaseSchemaVersion"
        ],
        "properties": {
          "status": {
            "const": "ok"
          },
          "service": {
            "const": "tohseno-reference-node"
          },
          "databaseSchemaVersion": {
            "const": 1
          }
        }
      }
    },
    "responses": {
      "InvalidRecord": {
        "description": "The signed public record is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NodeErrorPayload"
            }
          }
        }
      },
      "Conflict": {
        "description": "The record conflicts with the accepted Shot history.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NodeErrorPayload"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The request exceeds the node record limit.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NodeErrorPayload"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "The request is not application/json.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NodeErrorPayload"
            }
          }
        }
      },
      "CapacityExceeded": {
        "description": "This replaceable node's bounded history capacity is exhausted.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NodeErrorPayload"
            }
          }
        }
      },
      "NotFound": {
        "description": "No public Shot was found.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/NodeErrorPayload"
            }
          }
        }
      }
    }
  }
}
