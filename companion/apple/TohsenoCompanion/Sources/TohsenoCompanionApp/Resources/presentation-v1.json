    "testing": "building",
    "verifying": "building",
    "repairing": "building",
    "waiting_for_device": "ready_for_phone",
    "installing": "installing",
    "launching": "installing",
    "accepted": "installed",
    "failed": "failed",
    "cancelled": "failed"
  }
