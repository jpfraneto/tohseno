{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/schemas/private-planning/apple-capability-profile.schema.json",
  "title": "TOHSENO local Apple capability profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_digest", "xcode_version", "xcode_build", "iphoneos_sdk_version", "simulator_runtimes", "connected_devices", "last_known_devices", "resolutions", "observed_at_unix"],
  "properties": {
    "schema": {"const": "tohseno.apple-capability-profile/1"},
    "catalog_digest": {"$ref": "#/$defs/digest"},
    "xcode_version": {"type": "string", "minLength": 1},
    "xcode_build": {"type": "string", "minLength": 1},
    "iphoneos_sdk_version": {"type": "string", "minLength": 1},
    "simulator_runtimes": {"type": "array", "items": {"$ref": "#/$defs/runtime"}},
    "connected_devices": {"type": "array", "items": {"$ref": "#/$defs/device"}},
    "last_known_devices": {"type": "array", "items": {"$ref": "#/$defs/device"}},
    "signing_team": {"$ref": "#/$defs/signing_team"},
    "resolutions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/resolution"}},
    "observed_at_unix": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
    "state": {"enum": ["supported", "supported_with_permission", "supported_with_entitlement", "hardware_specific", "simulator_unavailable", "unknown_until_physical_device", "unsupported_by_current_sdk", "unsupported_by_factory"]},
    "runtime": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "identifier"],
      "properties": {"name": {"type": "string"}, "version": {"type": "string"}, "build_version": {"type": "string"}, "identifier": {"type": "string"}}
    },
    "device": {
      "type": "object", "additionalProperties": false,
      "required": ["product_type", "os_version", "physical", "connection_transport", "available_capability_classes"],
      "properties": {
        "product_type": {"type": "string", "minLength": 1}, "marketing_name": {"type": "string"},
        "os_version": {"type": "string", "minLength": 1}, "os_build": {"type": "string"},
        "physical": {"const": true}, "connection_transport": {"type": "string", "minLength": 1},
        "available_capability_classes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "device_resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["product_type", "state"],
      "properties": {"product_type": {"type": "string"}, "state": {"$ref": "#/$defs/state"}}
    },
    "signing_team": {
      "type": "object", "additionalProperties": false,
      "required": ["team_id", "provisioning"],
      "properties": {
        "team_id": {"type": "string", "pattern": "^[A-Z0-9]{10}$"},
        "team_name": {"type": "string", "minLength": 1},
        "provisioning": {"enum": ["paid", "free", "unknown"]}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["identifier", "state", "simulator_state", "device_states", "physical_device_verification"],
      "properties": {
        "identifier": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "state": {"$ref": "#/$defs/state"}, "simulator_state": {"$ref": "#/$defs/state"},
        "device_states": {"type": "array", "items": {"$ref": "#/$defs/device_resolution"}},
        "physical_device_verification": {"type": "boolean"}
      }
    }
  }
}
