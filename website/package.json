{
  "name": "tohseno",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --watch apps/site/server.ts",
    "start": "bun apps/site/server.ts",
    "relay:cleanup": "bun apps/site/scripts/cleanup-intent-relay.ts",
    "companion-relay:dev": "bun --watch apps/companion-relay/server.ts",
    "companion-relay:start": "bun apps/companion-relay/server.ts",
    "companion-relay:cleanup": "bun apps/companion-relay/scripts/cleanup.ts",
    "companion-relay:test": "bun test apps/companion-relay/tests",
    "companion:local": "../scripts/local-companion-e2e.sh",
    "companion:local:test": "../scripts/test-local-companion-e2e.sh",
    "site:icons": "bun apps/site/scripts/extract-shot-icons.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.18",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.2.18"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "viem": "^2.37.6"
  }
}
