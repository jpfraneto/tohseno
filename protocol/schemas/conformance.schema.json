{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/protocol/schemas/conformance.schema.json",
  "title": "TOHSENO conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "shot_id",
    "sequence",
    "conformant",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "tohseno.conformance/1"
    },
    "shot_id": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "conformant": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "expected",
          "observed",
          "evidence_path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$",
            "maxLength": 100
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_checked"
            ]
          },
          "expected": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "observed": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "evidence_path": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
              }
            ]
          }
        }
      }
    }
  },
  "$comment": "The verifier additionally requires unique check ids and conformant to equal true exactly when every status is pass."
}
