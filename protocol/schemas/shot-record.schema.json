{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/protocol/schemas/shot-record.schema.json",
  "title": "TOHSENO Evolution record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema",
    "shot_id",
    "slug",
    "builder_id",
    "sequence",
    "previous",
    "fascia",
    "bundle_id",
    "bundle_version",
    "genesis_input_sha256",
    "source_tree_sha256",
    "fascia_sha256",
    "factory",
    "created_at"
  ],
  "properties": {
    "protocol": {
      "const": "tohseno"
    },
    "schema": {
      "const": "tohseno.shot/1"
    },
    "shot_id": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 63
    },
    "builder_id": {
      "$ref": "common.schema.json#/$defs/builderId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/bytes32"
        }
      ]
    },
    "fascia": {
      "const": "tohseno.apple/1"
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$",
      "maxLength": 255
    },
    "bundle_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "genesis_input_sha256": {
      "$ref": "common.schema.json#/$defs/bytes32"
    },
    "source_tree_sha256": {
      "$ref": "common.schema.json#/$defs/bytes32"
    },
    "fascia_sha256": {
      "$ref": "common.schema.json#/$defs/bytes32"
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "source_commit"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "legacy_latest_shot",
        "legacy_source_sha256"
      ],
      "properties": {
        "kind": {
          "const": "legacy_adoption"
        },
        "legacy_latest_shot": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967294
        },
        "legacy_source_sha256": {
          "$ref": "common.schema.json#/$defs/nonzeroBytes32"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "origin"
        ]
      },
      "then": {
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4294967295
          },
          "previous": {
            "type": "null"
          }
        }
      },
      "else": {
        "if": {
          "properties": {
            "sequence": {
              "const": 1
            }
          },
          "required": [
            "sequence"
          ]
        },
        "then": {
          "properties": {
            "previous": {
              "type": "null"
            },
            "bundle_version": {
              "const": 1
            }
          }
        },
        "else": {
          "properties": {
            "previous": {
              "$ref": "common.schema.json#/$defs/bytes32"
            }
          }
        }
      }
    }
  ],
  "$comment": "The protocol verifier additionally requires bundle_version == sequence. A legacy-adoption root requires sequence == legacy_latest_shot + 1 and previous null. A normal root is sequence 1 with previous null. Every later record omits origin and references the preceding protocol commitment."
}
