{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/protocol/schemas/app-metadata.schema.json",
  "title": "TOHSENO embedded Apple application metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema",
    "fascia",
    "shot_id",
    "builder_id",
    "sequence",
    "evolution_commitment",
    "source_tree_sha256",
    "fascia_sha256",
    "bundle_id",
    "bundle_version",
    "factory",
    "distribution",
    "capabilities",
    "network"
  ],
  "properties": {
    "protocol": {
      "const": "tohseno"
    },
    "schema": {
      "const": "tohseno.app-metadata/1"
    },
    "fascia": {
      "const": "tohseno.apple/1"
    },
    "shot_id": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "builder_id": {
      "$ref": "common.schema.json#/$defs/builderId"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "previous": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/bytes32"
        }
      ]
    },
    "origin": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "legacy_latest_shot",
            "legacy_source_sha256"
          ],
          "properties": {
            "kind": {
              "const": "legacy_adoption"
            },
            "legacy_latest_shot": {
              "type": "integer",
              "minimum": 1,
              "maximum": 4294967294
            },
            "legacy_source_sha256": {
              "$ref": "common.schema.json#/$defs/nonzeroBytes32"
            }
          }
        }
      ]
    },
    "evolution_commitment": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "source_tree_sha256": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "fascia_sha256": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
    },
    "bundle_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "source_commit"
      ],
      "properties": {
        "implementation": {
          "$ref": "#/$defs/factoryImplementation"
        },
        "version": {
          "$ref": "#/$defs/factoryVersion"
        },
        "source_commit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "supported_apple_surfaces"
      ],
      "properties": {
        "state": {
          "enum": [
            "local",
            "published",
            "app_store"
          ]
        },
        "supported_apple_surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "iphone",
              "ipad",
              "vision"
            ]
          }
        },
        "app_store_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/positiveSafeUint"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "app_store"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "required": [
              "app_store_id"
            ],
            "properties": {
              "app_store_id": {
                "$ref": "common.schema.json#/$defs/positiveSafeUint"
              }
            }
          },
          "else": {
            "properties": {
              "app_store_id": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "purpose",
          "details"
        ],
        "properties": {
          "capability": {
            "enum": [
              "local_storage",
              "network_access",
              "private_cloudkit_sync",
              "storekit",
              "notifications",
              "camera",
              "microphone",
              "location",
              "contacts",
              "health",
              "bluetooth",
              "other_apple_entitlements"
            ]
          },
          "purpose": {
            "$ref": "#/$defs/purpose"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/detail"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "capability": {
                  "enum": [
                    "private_cloudkit_sync",
                    "other_apple_entitlements"
                  ]
                }
              },
              "required": [
                "capability"
              ]
            },
            "then": {
              "properties": {
                "details": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "purpose"
        ],
        "properties": {
          "endpoint": {
            "$ref": "#/$defs/endpoint"
          },
          "purpose": {
            "$ref": "#/$defs/purpose"
          }
        }
      }
    },
    "registry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain_id",
            "contract"
          ],
          "properties": {
            "chain_id": {
              "const": 4663
            },
            "contract": {
              "$ref": "common.schema.json#/$defs/nonzeroAddress20"
            },
            "transaction": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/nonzeroBytes32"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "network": {
            "minItems": 1
          }
        },
        "required": [
          "network"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "contains": {
              "properties": {
                "capability": {
                  "const": "network_access"
                }
              },
              "required": [
                "capability"
              ]
            }
          }
        }
      },
      "else": {
        "properties": {
          "capabilities": {
            "not": {
              "contains": {
                "properties": {
                  "capability": {
                    "const": "network_access"
                  }
                },
                "required": [
                  "capability"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "factoryImplementation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "factoryVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "detail": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    },
    "endpoint": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  },
  "$comment": "The Rust and Swift validators additionally enforce UTF-8 byte bounds, unique capability IDs and network endpoints, bundle_version == sequence, native previous/origin lineage, and equality of evolution_commitment to the signed Shot record."
}
