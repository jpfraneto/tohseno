{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/protocol/schemas/release-authority-policy.schema.json",
  "title": "TOHSENO offline contract-activation authority policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "protocol",
    "protocol_major",
    "purpose",
    "threshold",
    "authorities",
    "issued_at"
  ],
  "properties": {
    "schema": {
      "const": "tohseno.release-authority-policy/1"
    },
    "protocol": {
      "const": "tohseno"
    },
    "protocol_major": {
      "const": 2
    },
    "purpose": {
      "const": "contract_generation_activation"
    },
    "threshold": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/authority"
      },
      "$comment": "The protocol validator additionally requires key IDs to be strictly ordered and threshold <= authority count."
    },
    "issued_at": {
      "$ref": "ontology.schema.json#/$defs/timestamp"
    }
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key_id",
        "public_key"
      ],
      "properties": {
        "key_id": {
          "$ref": "common.schema.json#/$defs/nonzeroBytes32"
        },
        "public_key": {
          "$ref": "common.schema.json#/$defs/p256PublicKey"
        }
      },
      "$comment": "key_id is SHA-256('TOHSENO-RELEASE-AUTHORITY-KEY-V1\\0' || x || y), deliberately distinct from Builder DeviceKey identity."
    }
  },
  "$comment": "A policy is inert until a client explicitly trusts its digest. No Builder, Shot owner, installation identity, relayer, or deployer is an authority by implication."
}
