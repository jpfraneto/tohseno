{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tohseno.com/protocol/schemas/app-metadata-v2.schema.json",
  "title": "TOHSENO embedded Apple expression identity v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocol_version",
    "schema",
    "fascia",
    "shot_id",
    "builder_id",
    "expression_id",
    "version_id",
    "version_ordinal",
    "genome_revision",
    "genome_digest",
    "lineage_sequence",
    "lineage_head",
    "source_tree_sha256",
    "fascia_sha256",
    "bundle_id",
    "bundle_version",
    "factory",
    "distribution",
    "capabilities",
    "network"
  ],
  "properties": {
    "protocol": {
      "const": "tohseno"
    },
    "protocol_version": {
      "const": "2"
    },
    "schema": {
      "const": "tohseno.app-metadata/2"
    },
    "fascia": {
      "const": "tohseno.apple/1"
    },
    "shot_id": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "builder_id": {
      "$ref": "common.schema.json#/$defs/builderId"
    },
    "expression_id": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "version_id": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "version_ordinal": {
      "$ref": "common.schema.json#/$defs/positiveSafeUint"
    },
    "genome_revision": {
      "$ref": "common.schema.json#/$defs/positiveSafeUint"
    },
    "genome_digest": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "lineage_sequence": {
      "$ref": "common.schema.json#/$defs/positiveSafeUint"
    },
    "lineage_head": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "source_tree_sha256": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "fascia_sha256": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "build_digest": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*(?:\\.[A-Za-z0-9][A-Za-z0-9-]*)+$"
    },
    "bundle_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "factory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation",
        "version",
        "source_commit"
      ],
      "properties": {
        "implementation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "supported_apple_surfaces"
      ],
      "properties": {
        "state": {
          "enum": [
            "local",
            "published",
            "app_store"
          ]
        },
        "supported_apple_surfaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "iphone",
              "ipad",
              "vision"
            ]
          }
        },
        "app_store_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/positiveSafeUint"
            }
          ]
        }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "purpose",
          "details"
        ],
        "properties": {
          "capability": {
            "enum": [
              "local_storage",
              "network_access",
              "private_cloudkit_sync",
              "storekit",
              "notifications",
              "camera",
              "microphone",
              "location",
              "contacts",
              "health",
              "bluetooth",
              "other_apple_entitlements"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "details": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        }
      }
    },
    "network": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "endpoint",
          "purpose"
        ],
        "properties": {
          "endpoint": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "registry": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain_id",
            "contract"
          ],
          "properties": {
            "chain_id": {
              "const": 4663
            },
            "contract": {
              "$ref": "common.schema.json#/$defs/nonzeroAddress20"
            },
            "transaction": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "common.schema.json#/$defs/nonzeroBytes32"
                }
              ]
            }
          }
        }
      ]
    },
    "legacy_v1_evolution_commitment": {
      "$ref": "common.schema.json#/$defs/nonzeroBytes32"
    }
  },
  "$comment": "New worlds place this strict /2 object at the already source-tree-excluded TOHSENO/embedded-provenance.json path. Historical /1 files remain exact. Decoders dispatch on schema; no second self-referential identity resource or new v1 tree-hash exclusion is introduced."
}
