# Read-only target for explicit contract audits and the mandatory EIP-7951
# capability probe. The repository has no successor-generation deployment
# command; ADR 0035's additive Claims script remains owner-attended and inert
# without governed deployment credentials and separate signed activation.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ADR 0034 public catalog. Keep both paths dark until an absolute durable
# owner-controlled volume and the 1.1 activation order are verified.
REGISTRY_ENABLED=false
# REGISTRY_ROOT=/var/lib/tohseno/registry
# Only immutable public source/icon blobs may move to R2. Catalogs, jobs,
# profiles, Claims, staging uploads, and migration evidence stay under
# REGISTRY_ROOT. R2 credentials belong in the hosting secret manager.
REGISTRY_BLOB_STORE=filesystem
# REGISTRY_R2_ACCOUNT_ID=<lowercase-32-character-cloudflare-account-id>
# REGISTRY_R2_BUCKET=tohseno-registry
# REGISTRY_R2_ACCESS_KEY_ID=<least-privilege-object-read-write-key>
# REGISTRY_R2_SECRET_ACCESS_KEY=<secret-manager-only>
REGISTRY_GLOBAL_RATE=600
REGISTRY_SOURCE_RATE=60
REGISTRY_MAX_STAGING_RECORDS=1000
REGISTRY_MAX_STAGING_BYTES=10737418240
REGISTRY_RELAYER_ENABLED=false
# REGISTRY_RELAYER_PRIVATE_KEY=<dedicated-funded-relayer-key-from-secret-manager>

# ADR 0035 additive Claims. Omit all coordinates until the exact canonical
# signed activation is committed and independently verified. Index reads must
# run and rebuild dark before the separately approved write relay is enabled.
CLAIMS_INDEXER_ENABLED=false
CLAIMS_RELAYER_ENABLED=false
# CLAIMS_CONTRACT_ADDRESS=0x...
# CLAIMS_ACTIVATION_SIGNING_DIGEST=0x...
# CLAIMS_ACTIVATION_EVIDENCE_PATH=/var/lib/tohseno/evidence/signed-claims-activation-1.json
# CLAIMS_AUTHORITY_POLICY_PATH=/var/lib/tohseno/evidence/release-authority-policy.json
# CLAIMS_DEPLOYMENT_BLOCK=...
# CLAIMS_RELAYER_PRIVATE_KEY=<dedicated-funded-claims-relayer-key-from-secret-manager>

# No deployer, relayer, token-association, or broadcast secrets belong in this
# file. Future activation requires a separately reviewed workflow and signed
# release-authority policy. Never add a raw key, mnemonic, or keystore password.

# Native Mac distribution is disabled until the owner has signed, notarized,
# stapled, verified, uploaded, and independently hashed the exact DMG.
MACOS_DOWNLOAD_ENABLED=false
# MACOS_DOWNLOAD_CHANNEL=release-candidate
# MACOS_DOWNLOAD_URL=https://downloads.tohseno.com/Tohseno-1.1.0-rc.2.dmg
# MACOS_DOWNLOAD_SHA256=<lowercase-sha256-of-that-exact-dmg>
# TOHSENO_WELCOME_COMPUTE_URL is release-time Mac helper configuration, not a
# mutable production-service variable. Set it only while building the signed
# candidate; use an HTTPS or mailto URL and record the value in release evidence.
# TOHSENO_WELCOME_COMPUTE_URL=mailto:welcome@example.com

# The managed-compute service is independent of the legacy subscription
# service and is disabled by default. Production values belong in the hosting
# secret manager, never this file or a client bundle.
MANAGED_COMPUTE_ENABLED=false
MANAGED_COMPUTE_PROVIDER=bankr
# MANAGED_COMPUTE_ROOT=/var/lib/tohseno/managed-compute
# BANKR_BASE_URL=https://llm.bankr.bot
# BANKR_API_KEY=<least-privilege-llm-gateway-key>
# BANKR_MODEL_ALLOWLIST=<comma-separated-server-approved-model-ids>
MANAGED_RATE_LIMIT_PER_MINUTE=30
# STRIPE_SECRET_KEY=<secret-manager-reference>
# STRIPE_WEBHOOK_SECRET=<secret-manager-reference>
# Retained recurring-billing compatibility only. The corresponding public key
# is pinned in billing/verification-key-p256.txt before building the release.
# BILLING_RECEIPT_SIGNING_PKCS8_BASE64URL=<secret-manager-reference>
# STRIPE_BALANCE_PRICE_10=price_...
# STRIPE_BALANCE_PRICE_25=price_...
# STRIPE_BALANCE_PRICE_50=price_...
# MANAGED_CHECKOUT_SUCCESS_URL=https://tohseno.com/billing/success
# MANAGED_CHECKOUT_CANCEL_URL=https://tohseno.com/billing/cancel
# TOHSENO_OPERATOR_TOKEN_SHA256=<lowercase-sha256-of-a-random-operator-token>
BANKR_LAUNCH_FEE_FUNDING_CONFIRMED=false
# BANKR_LAUNCH_FEE_FUNDING_REFERENCE=<private-account-evidence-reference>
