# Public network coordinates. The official rate-limited endpoint is suitable
# for read-only probing; use an authenticated provider for production work.
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ETHEREUM_MAINNET_RPC_URL=

# Deployment requires a Foundry encrypted-keystore account name. Relaying may
# use its own configured account. Never put a raw key, mnemonic, or keystore
# password in this file or shell history.
TOHSENO_DEPLOYER_ACCOUNT=
TOHSENO_EXPECTED_DEPLOYER_ADDRESS=
TOHSENO_RELAYER_ACCOUNT=

# Explicit safety gates. Deployment scripts require the literal value `1`.
TOHSENO_ALLOW_EXPERIMENTAL_MAINNET=0
# Leave empty for simulation. The deployment README documents the exact,
# deliberately long value required only for a real candidate broadcast.
TOHSENO_DEPLOY_CONFIRMATION=
# Forwarded by lifecycle-mainnet.sh only when non-empty. The CLI checks its
# exact documented sentence only if --submit finds a missing BuilderAccount.
TOHSENO_BUILDER_ACCOUNT_DEPLOYMENT_CONFIRMATION=
TOHSENO_ALLOW_APPCOIN_ASSOCIATION=0

# Optional relation. Both values must be explicit and token bytecode must exist.
TOHSENO_TOKEN_CHAIN_ID=
TOHSENO_TOKEN_ADDRESS=

# Candidate services remain closed by default.
TOHSENO_RELAYER_ALLOWLIST=
TOHSENO_RELAYER_MAX_SPONSORED_GAS=250000
